# Cognitive Canvas Backend - Environment Variables

# OpenRouter API Key (required for all AI agents)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cerebras API Key (optional - for ultra-fast task generation)
# Get your API key from: https://cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Instructions:
# 1. Copy this file to .env (without .example)
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control
